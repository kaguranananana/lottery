  "cards": [
    {
      "title": "为什么不能回填",
      "dot": "amber",
      "items": [
        "奖品MySQL结算可能滞后，活动MySQL也未随每次参与扣减。用这些值覆盖运行库存会让已售库存复活。",
        "warmupStockForActivity只允许PASS，DOING不能靠启动预热恢复；没有实现运行期对账算法。"
      ]
    },
    {
      "title": "真实售罄与状态错误",
      "dot": "cyan",
      "items": [
        "Lua 对存在且余量<=0的 Key 返回售罄，此时才走未中奖；缺失 Key 明确抛出。",
        "奖品异常保留 state=0 与原 requestId；活动异常发生在新 take 持久化之前。"
      ]
    },
    {
      "title": "恢复不等于重新预热",
      "dot": "rose",
      "items": [
        "人工节点表示当前待处理边界，不表示已有运行期自动修复功能。",
        "回补也只能修改现存 Key，缺失时继续抛出；绝不隐式创建余量为1的新库存。"
      ]
    }
  ]
}
